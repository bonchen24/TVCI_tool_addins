# Copy to .env.local and set deployment-managed values. Never commit .env.local.
SUPERADMIN_USERNAME=replace-with-bootstrap-username
SUPERADMIN_INITIAL_PASSWORD=

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:1350/api/drive/callback
DRIVE_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

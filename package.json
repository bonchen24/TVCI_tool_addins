{
  "name": "tvci-word-addin",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev-server": "webpack serve --mode development",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "dev": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest/manifest.xml desktop --no-debug --dev-server-port 38473",
    "start:debug": "office-addin-debugging start manifest/manifest.xml desktop --dev-server-port 38473",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-client.ps1",
    "stop": "office-addin-debugging stop manifest/manifest.xml",
    "validate-manifest": "office-addin-manifest validate manifest/manifest.xml",
    "start:full": "npm run start:local",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-client.ps1",
    "setup:local": "npm run setup",
    "repair": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-client.ps1 -SkipInstall",
    "repair:local": "npm run repair",
    "uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-client.ps1",
    "uninstall:local": "npm run uninstall",
    "uninstall:local:purge-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-client.ps1 -RemoveCertificate",
    "setup:local-startup": "powershell -ExecutionPolicy Bypass -File scripts/local-startup.ps1",
    "remove:local-startup": "powershell -ExecutionPolicy Bypass -File scripts/local-startup.ps1 -Uninstall",
    "package:client": "npm run build && node scripts/package-client.mjs",
    "package:local-client": "node scripts/package-local-client.mjs",
    "installer": "node scripts/package-installer.mjs",
    "test:installer": "node scripts/verify-installer.mjs",
    "test:direct": "node --experimental-strip-types --test qa/direct-api.node.test.ts",
    "test:models": "node --experimental-strip-types --test qa/model-discovery.node.test.ts",
    "test:qa": "node --experimental-strip-types --test --test-isolation=none qa/*.node.test.ts"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@microsoft/office-js": "^1.1.110",
    "@types/jest": "^29.5.14",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.10.2",
    "@types/office-js": "^1.0.541",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "office-addin-debugging": "latest",
    "office-addin-dev-certs": "latest",
    "office-addin-manifest": "latest",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
